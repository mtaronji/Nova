{
    "$schema": "./pipeline.schema.json",
    "shaderStages": [
        {"stage": "vertex","path": "shaders/identityV.spv"},
        {"stage": "fragment","path": "shaders/identityF.spv"}
    ],
    "inputAssembly": {
        "topology": "triangle_list"
    },
    "rasterizer": {
        "depthClampEnable": false,
        "rasterizerDiscardEnable": false,
        "polygonMode": "fill",
        "cullMode": "back",
        "depthBiasEnable": false,
        "frontFace": "counter_clockwise"

    },
    "multisampling": {
        "sampleShadingEnable": false,
        "rasterizationSamples":1
    },
    "colorBlend": {
        "logicOpEnable": false,
        "attachments": [
            
        ]
    },
    "dynamicStates": [
        "viewport","scissor"
    ]
        
    
}