{
  "$schema": "../config/pipeline.schema.json",
    "shaderStages": [
        {"stage": "vertex","path": "shaders/identity.vert.spv"},
        {"stage": "fragment","path": "shaders/identity.frag.spv"}
    ],
    "inputAssembly": {
        "topology": "triangle_list",
        "primitiveRestartEnable": false
    },
    "rasterizer": {
      "depthClampEnable": false,
      "rasterizerDiscardEnable": false,
      "polygonMode": "fill",
      "cullMode": "back",
      "depthBiasEnable": false,
      "frontFace": "counter_clockwise",
      "lineWidth": 1.0
    },
    "renderpasskey": "msaa4.json",
    "vertextype": "pntc",
    "multisampling": {
        "sampleShadingEnable": true,
        "rasterizationSamples":4,
        "minSampleShading": 0.5
    },
    "depthStencil": {
        "depthCompareOp": "less",
        "depthTestEnable": true,
        "depthWriteEnable": true,
        "stencilTestEnable": false
    },
    "colorBlend": {
        "logicOp": "VK_LOGIC_OP_COPY",
        "logicOpEnable": false,
        "blendConstants": [0.0, 0.0, 0.0, 0.0],
        
        "attachments": [
            {
                "blendEnable": false,
                "colorWriteMask": ["r","g","b","a"]
                
            }
        ]
    },
    "dynamicStates": [
        "viewport","scissor"
    ],

  "pushConstants": [
    {
      "name": "frameinfo",
      "offset": 0,
      "stage": [ "vertex", "fragment" ]
    }
  ],
  "descriptorFile": "default.json" 
}